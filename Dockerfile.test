# INtelliBOX - Test Docker Image (includes test suite and dev dependencies)
FROM registry1.dso.mil/ironbank/redhat/ubi/ubi9

# Set working directory
WORKDIR /app

# Install Python 3.12, build tools, and Chromium dependencies for Playwright
RUN dnf install -y \
    python3.12 \
    python3.12-pip \
    python3.12-devel \
    gcc \
    gcc-c++ \
    libpq-devel \
    nss \
    nspr \
    atk \
    at-spi2-atk \
    cups-libs \
    libdrm \
    libXcomposite \
    libXdamage \
    libXrandr \
    libXext \
    libX11 \
    libXfixes \
    libXcursor \
    mesa-libgbm \
    pango \
    cairo \
    alsa-lib \
    libxshmfence \
    libxkbcommon \
    dbus-libs \
    expat \
    && dnf clean all

# Make python3.12 the default
RUN alternatives --set python3 /usr/bin/python3.12 || true && \
    ln -sf /usr/bin/python3.12 /usr/bin/python && \
    ln -sf /usr/bin/pip3.12 /usr/bin/pip

# Copy dependency files
COPY pyproject.toml /app/

# Copy application code
COPY src/ /app/src/
COPY alembic/ /app/alembic/
COPY alembic.ini /app/

# Copy test suite and runner
COPY tests/ /app/tests/
COPY features/ /app/features/
COPY run_tests.py /app/

# Install Python dependencies (including dev/test)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e ".[dev]" && \
    playwright install chromium

# Create data directories
RUN mkdir -p /app/data/inbox /app/data/emails

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Default: run the test suite
CMD ["python", "run_tests.py"]
