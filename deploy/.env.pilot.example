# INtelliBOX Pilot Deployment — AWS Configuration
# Copy this to .env.pilot and fill in your values
#
# Prerequisites:
#   - AWS CLI installed and configured (aws configure)
#   - An EC2 key pair created in your AWS account
#   - A DuckDNS subdomain registered at https://www.duckdns.org

AWS_REGION=us-east-2
AWS_KEY_NAME=intellibox-key
INSTANCE_TYPE=t3.micro
SSH_KEY_PATH=~/Downloads/intellibox-key.pem
