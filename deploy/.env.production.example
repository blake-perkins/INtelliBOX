# INtelliBOX Production Environment
# Copy this to .env.production and fill in real values

# ── Domain (used by nginx/Certbot) ──────────────────────────────────────────
DOMAIN=your-name.duckdns.org
DUCKDNS_TOKEN=your-duckdns-token

# ── Database ────────────────────────────────────────────────────────────────
# SQLite (local development):
#   DATABASE_URL=sqlite:///./data/intellibox.db
# PostgreSQL (production — used by docker-compose):
DATABASE_URL=postgresql+psycopg://intellibox:CHANGE_ME@localhost:5432/intellibox

# ── OpenAI API ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-real-api-key
OPENAI_MODEL=gpt-4o-mini

# ── Email Sending (SMTP) — for outgoing reports ────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@outlook.com
SMTP_PASSWORD=your-email-password
REPORT_FROM=your-email@outlook.com
REPORT_RECIPIENTS=team-member1@example.com,team-member2@example.com

# ── Reporting ───────────────────────────────────────────────────────────────
REPORT_TIME=06:00
TIMEZONE=America/New_York
PROGRAM_NEWS_DAYS=7

# ── Authentication ──────────────────────────────────────────────────────────
# "disabled" (default) = no login required
# "local"              = username/password (create users with: intellibox user create)
# "oidc"               = SSO via Keycloak, Azure AD, Okta, etc.
AUTH_MODE=disabled
SECRET_KEY=change-me-use-python-secrets-token_urlsafe-32

# OIDC settings (only needed when AUTH_MODE=oidc)
# OIDC_ISSUER_URL=https://keycloak.example.com/realms/your-realm
# OIDC_CLIENT_ID=intellibox
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_ROLES_CLAIM=realm_access.roles
# OIDC_ADMIN_ROLE=intellibox-admin

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Team Members (comma-separated, for assignment autocomplete) ─────────────
TEAM_MEMBERS=
